// Synthetic recurrent graph, NOT a pretrained transformer. Four token IDs.
// Row-major signed i8 vocabulary head: [-1,-1], [1,-2], [1,-2], [-2,1].
int lmhead(int weights, int hidden) {
    Tensor.SetShape(4, 2);
    int projection = Tensor.MatVecI8(weights, hidden);
    return Tensor.ScaleI32(projection, 2);
}

Memory.Set(4096, 255);
Memory.Set(4097, 255);
Memory.Set(4098, 1);
Memory.Set(4099, 254);
Memory.Set(4100, 1);
Memory.Set(4101, 254);
Memory.Set(4102, 254);
Memory.Set(4103, 1);
int weights = Span.Make(4096, 8);

// Token embeddings: [1,0], [0,2], [2,1], [1,3].
Memory.Set(4128, 1);
Memory.Set(4129, 0);
Memory.Set(4130, 0);
Memory.Set(4131, 2);
Memory.Set(4132, 2);
Memory.Set(4133, 1);
Memory.Set(4134, 1);
Memory.Set(4135, 3);
int hidden = Span.Make(4160, 2);
int state0 = 0;
int state1 = 0;
int token = 0;
int tokenBudget = 8;
int step = 0;
while (step < tokenBudget) {
    // Bounded recurrent state: h' = (h + embedding[token]) mod 8.
    state0 = (state0 + Memory.Get(4128 + token * 2)) % 8;
    state1 = (state1 + Memory.Get(4129 + token * 2)) % 8;
    Memory.Set(4160, state0);
    Memory.Set(4161, state1);
    int logits = lmhead(weights, hidden);
    token = Tensor.ArgMaxI32(logits);
    Io.Write(logits);
    Io.WriteByte(token);
    step = step + 1;
}
